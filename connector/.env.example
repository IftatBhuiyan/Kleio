# Copy to .env (ignored). Never commit real credentials.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1/
TRANSCRIPTION_MODEL=whisper-1
# Optional: leave blank to return the transcription without cleanup/translation.
CLEANUP_MODEL=gpt-4o-mini
# Generate with: openssl rand -hex 32
# Paste this backend token (NOT your API key) into Kleio Settings.
KLEIO_ACCESS_TOKEN=
PORT=8080
